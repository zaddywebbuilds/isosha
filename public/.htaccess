# =====================================================================
# Isosha — Apache configuration for eyesosharp.com
# =====================================================================
#
# This file ships inside the build and belongs in the web root, beside
# index.html. The host is Namecheap, so Apache and cPanel: these rules
# apply. On Nginx they do nothing and the equivalent goes in the server
# block instead.
#
# BACK UP THE EXISTING .htaccess BEFORE REPLACING IT. Rename it to
# .htaccess.wordpress-backup rather than deleting it. It is the one
# step here that cannot be undone from the file manager.
#
# ---------------------------------------------------------------------
# WHAT THIS DOES, AND WHY IT IS NOT A CATCH-ALL
# ---------------------------------------------------------------------
#
# WordPress stays installed and keeps running. It has to.
#
# The order form posts to the Xurge CRM, and the CRM then sends the
# customer to the thank-you page, which is an Elementor page served by
# WordPress at /thank-you/. That page is a real WordPress permalink,
# not a file on disk. A rule that sent every unmatched path to
# index.html would therefore swallow it, and every customer who placed
# an order would land back on the product page with no confirmation
# that the order went through. The orders would still reach the CRM, so
# nothing would look broken from the outside, which is the worst way
# for this to fail.
#
# So the split is:
#
#   /                  the static Isosha site     (index.html)
#   /assets/...        static files               (served directly)
#   /thank-you/        WordPress                  (Elementor page)
#   /wp-admin, /wp-*   WordPress                  (dashboard, uploads)
#   anything else      WordPress                  (its own 404)
#
# Only the homepage is taken from WordPress. Everything else it used to
# answer, it still answers.

# This single line is what hands the homepage to the static site.
# Without it the host's default index serves WordPress at "/" and no
# visitor ever reaches the Isosha page.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Standard WordPress rules, unchanged. A request for a real file or
  # directory is served as-is, which covers index.html, /assets/ and
  # everything in the build. Anything else goes to WordPress.
  RewriteRule ^index\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
</IfModule>

# ---------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------
#
# This product is sold to people on Nigerian mobile data, so the large
# files are worth caching hard. Two different rules, for a reason.

<IfModule mod_expires.c>
  ExpiresActive On

  # index.html is never cached. It names the current JS and CSS bundle,
  # so a cached copy would keep serving yesterday's site.
  <FilesMatch "\.(html|xml|txt)$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>

  # Bundles and fonts carry a content hash in the filename, so a changed
  # file is a changed name and a year is safe.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # Product and section photography: stable, but the names are not
  # hashed, so a month rather than a year.
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    ExpiresDefault "access plus 1 month"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Customer review material is deliberately cached for one day only.
#
# These are real customers' messages and voices, published under a
# permission they can withdraw. If one of them asks to be taken down,
# the review is pulled by setting `publish: false` and rebuilding, and
# it then has to actually disappear. A one-year cache would leave a
# withdrawn review sitting in browsers and CDNs long after the site
# stopped serving it. A day is the difference between honouring that
# request and only appearing to.
#
# LocationMatch is not allowed in .htaccess, so this is scoped by the
# directory the file sits in instead.
<IfModule mod_expires.c>
  <Files ~ "^(voice-note|review)-">
    ExpiresDefault "access plus 1 day"
  </Files>
</IfModule>

<IfModule mod_headers.c>
  <Files ~ "^(voice-note|review)-">
    Header set Cache-Control "public, max-age=86400"
  </Files>
</IfModule>

# ---------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------
#
# WebP, Ogg and M4A are already compressed; squeezing them again only
# burns CPU, so they are left out.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ---------------------------------------------------------------------
# Media types
# ---------------------------------------------------------------------
#
# Older Apache builds do not know these, and a voice note served as the
# wrong type simply will not play.

AddType audio/ogg .ogg
AddType audio/mp4 .m4a
AddType image/webp .webp
AddType font/woff2 .woff2
